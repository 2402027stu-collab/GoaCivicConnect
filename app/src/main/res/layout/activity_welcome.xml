<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Main Content -->

    <LinearLayout
        android:id="@+id/welcomeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- LOGO -->

        <ImageView
            android:id="@+id/imgWelcomeLogo"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:src="@drawable/goa_civic_logo"
            android:scaleType="fitCenter"
            android:contentDescription="Goa Civic Connect Logo" />


        <!-- APP NAME -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="GOA CIVIC CONNECT"
            android:textColor="#0D2347"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />


        <!-- TAGLINE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Report • Resolve • Build a Better Goa"
            android:textColor="#1268E8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />


        <!-- DESCRIPTION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Your simple way to report civic issues, track complaints and connect with government departments."
            android:textColor="#64748B"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />


        <!-- GET STARTED BUTTON -->

        <Button
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#1268E8"
            android:text="Get Started  →"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:elevation="4dp" />


        <!-- GOVERNMENT TEXT -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Government of Goa • Citizen Services"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>